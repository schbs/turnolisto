# TurnoListo: variables de entorno. Copiá este archivo a .env.local y completalo a mano (nunca se sube al repo).
# Todos los valores de acá son FALSOS.

# --- WhatsApp Cloud API (developers.facebook.com → tu app → WhatsApp → Configuración de la API) ---
# Token de acceso (temporal de 24 h para probar, o de usuario del sistema para algo estable).
WHATSAPP_TOKEN=EAAG-falso-000000000000
# "Identificador del número de teléfono" del número de prueba de Meta.
WHATSAPP_PHONE_NUMBER_ID=000000000000000
# Texto que inventás vos y repetís en la configuración del webhook de Meta (verificación GET).
WHATSAPP_VERIFY_TOKEN=inventa-un-texto-largo
# "Clave secreta de la app" (Configuración de la app → Básica). Sirve para verificar X-Hub-Signature-256.
WHATSAPP_APP_SECRET=00000000000000000000000000000000
# "Identificador de la cuenta de mensajes" (WhatsApp → Configuración de la API). Para crear la plantilla de recordatorio.
WHATSAPP_WABA_ID=000000000000000
# Nombre de la plantilla aprobada para los recordatorios (vacío: se mandan botones, que solo llegan dentro de las 24 h).
WHATSAPP_PLANTILLA_RECORDATORIO=recordatorio_turno
# Modo demo: números (wa_id, separados por coma) con los que el bot habla: solo les escribe a ellos y solo les contesta
# a ellos (el resto se ignora sin gastar IA). Vacío = sin restricción.
# Los pacientes del seed son ficticios pero sus números podrían existir: en la demo, dejá solo tu celular de prueba.
WHATSAPP_DESTINOS_PERMITIDOS=5492990000000

# --- Gemini (aistudio.google.com → Get API key). Free tier: confirmar límites. Solo datos ficticios. ---
GEMINI_API_KEY=AIza-falso-000000000000000000000000000
# Opcional: otro modelo (por defecto gemini-3.5-flash; gemini-2.5-flash ya no está disponible para cuentas nuevas).
# GEMINI_MODEL=gemini-3.5-flash

# --- Groq (console.groq.com → API Keys). Whisper para transcribir audios. ---
GROQ_API_KEY=gsk_falso_000000000000000000000000

# --- Google Calendar (Google Cloud → IAM → Cuentas de servicio → Claves → JSON) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=turnolisto@proyecto-falso.iam.gserviceaccount.com
# La clave privada del JSON, en una línea con \n.
GOOGLE_PRIVATE_KEY=pegar-el-campo-private_key-del-JSON-o-usar-scripts/cargar-cuenta-servicio.mjs
# ID del calendario de prueba compartido con la cuenta de servicio (Configuración del calendario → Integrar).
GOOGLE_CALENDAR_ID=falso@group.calendar.google.com

# --- Supabase (supabase.com → proyecto → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://proyecto-falso.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ-falso
# Solo del lado del servidor: nunca con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ-falso

# --- Recordatorios (Vercel Cron manda "Authorization: Bearer <CRON_SECRET>") ---
CRON_SECRET=inventa-otro-texto-largo

# --- Derivación a recepción: casilla de prueba (en la demo, una casilla tuya o @example.com) ---
RECEPCION_EMAIL=recepcion@example.com

# --- Panel de recepción: usuario demo de Supabase Auth (npm run db:seed lo crea y completa estas dos solo) ---
PANEL_DEMO_EMAIL=recepcion.demo@example.com
PANEL_DEMO_PASSWORD=se-genera-sola
